PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Local docker-compose Postgres. For a hosted Postgres (Supabase/Neon/etc.),
# use the connection string your provider gives you — do NOT commit it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/connecthub?schema=public"

REDIS_URL="redis://localhost:6379"

# Generate real random values for these, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Leaving these unset/weak is tolerated in development but the app will
# refuse to start in production (NODE_ENV=production) without real values —
# see backend/src/config/validateEnv.ts.
JWT_ACCESS_SECRET="2ff9464acd205cd69127d0dae23b955379393a33a3737995acd8603dbd7ce6eca16021746f576f817ca00f12106103c2"
JWT_REFRESH_SECRET="6f0a752023edd244b0784dc827de84bffc6f0b37d6de323c9b50ba95ba07b994439553e41656e65df89f6aa75c68045c"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# File storage. REQUIRED for any deployment with an ephemeral filesystem
# (Render, Railway, most container/PaaS free tiers, and any multi-instance
# deployment) — without these, uploaded files are written to local disk and
# are silently wiped on every restart/redeploy, or invisible to other
# instances behind a load balancer. See config/cloudinary.ts.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email. Without these, verification emails are only logged to the console
# and new signups can never verify their account. Use a dedicated
# transactional email provider (SendGrid/Postmark/SES) in production rather
# than a personal Gmail account + app password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-smtp-username@example.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM="ConnectHub <no-reply@connecthub.com>"

# Google SSO (optional). Leave unset to disable Google sign-in entirely — the
# "Continue with Google" button won't appear on the login page, and the
# admin panel will show SSO as "Not Configured." To enable:
#   1. Create an OAuth 2.0 Client ID in Google Cloud Console
#      (APIs & Services > Credentials > Create Credentials > OAuth client ID,
#      type "Web application").
#   2. Add an Authorized redirect URI matching GOOGLE_REDIRECT_URI below
#      exactly (must match byte-for-byte, including http vs https).
#   3. Fill in the three values below.
# Even with these set, an admin can still turn SSO off for the workspace
# from Admin > Organization Settings > Single Sign-On.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/v1/auth/sso/google/callback"

# Concurrent-session ("same credentials, multiple browsers") policy. This is
# normally set by an Admin at runtime from Organization Settings > Session &
# Login Policy, and defaults to SINGLE_SESSION (signing in on a new
# browser/device signs the account out everywhere else) if never configured.
# Set this env var only if you need to hard-pin the policy at the
# infrastructure level regardless of what an Admin picks in the UI — when
# set, it always wins. One of: SINGLE_SESSION | LIMIT_3 | UNLIMITED.
# DUPLICATE_LOGIN_POLICY=""
